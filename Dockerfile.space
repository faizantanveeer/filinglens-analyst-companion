# Single-container image for Hugging Face Spaces (one exposed port: 7860).
# Next.js serves the UI and proxies /api/* to FastAPI on localhost:8000 (same origin, so no CORS needed).
FROM node:22-slim AS web
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci
COPY frontend ./
ENV NEXT_PUBLIC_API_URL=/api BACKEND_INTERNAL_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.13-slim
COPY --from=web /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
ENV PYTHONUNBUFFERED=1 FASTEMBED_CACHE_PATH=/app/models DATA_DIR=/tmp/filinglens     FRONTEND_ORIGIN=http://localhost:7860 NODE_ENV=production PORT=7860 HOSTNAME=0.0.0.0
COPY requirements.txt requirements-local.txt ./
RUN pip install --no-cache-dir -r requirements-local.txt
COPY backend ./backend
RUN python -c "from backend.app.embeddings import dense_model, sparse_model, rerank_model; dense_model(); sparse_model(); rerank_model()"
COPY --from=web /app/.next/standalone ./web
COPY --from=web /app/.next/static ./web/.next/static
RUN useradd -m -u 1000 user && chown -R user /app
USER user
EXPOSE 7860
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 & exec node web/server.js"]
