# Backend
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=data
# Abstain when the best rerank score is below this (tuned in eval/results.md)
MIN_RERANK_SCORE=0.0
# Optional last-resort fallback to a local Ollama model (used only if Ollama is running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=
# Ingestion: page-parallel parsing workers (4 suits most laptops)
PARSE_WORKERS=4
# SEC EDGAR import: the SEC requires a User-Agent with contact details
SEC_USER_AGENT=FilingLens your.email@example.com

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# No LLM API keys here: users enter them in Settings; they live only in the browser session.
